# OPENROUTER_API_KEY: Required for generating personalized birthday content.
OPENROUTER_API_KEY=

# POLLINATIONS_API_KEY: Required for generating custom birthday cake images.
POLLINATIONS_API_KEY=

# CLOUDINARY_CLOUD_NAME: Your Cloudinary cloud name.
CLOUDINARY_CLOUD_NAME=

# CLOUDINARY_API_KEY: Your Cloudinary API key.
CLOUDINARY_API_KEY=

# CLOUDINARY_API_SECRET: Your Cloudinary API secret (Server-side only).
CLOUDINARY_API_SECRET=

# CLOUDINARY_UPLOAD_PRESET: Your Cloudinary upload preset.
CLOUDINARY_UPLOAD_PRESET=

# CLOUDFLARE_D1_DATABASE_ID: The ID of your Cloudflare D1 database.
CLOUDFLARE_D1_DATABASE_ID=

# CLOUDFLARE_ACCOUNT_ID: Your Cloudflare account ID.
CLOUDFLARE_ACCOUNT_ID=

# CLOUDFLARE_API_TOKEN: Your Cloudflare API token with D1 edit permissions.
CLOUDFLARE_API_TOKEN=
